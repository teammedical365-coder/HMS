# ─────────────────────────────────────────────────────────────────────────────
# Medical365 HMS — Server Environment Variables (.env.example)
# Copy to .env and configure for your environment. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=3000
DEPLOYMENT_MODE=cloud
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database
MONGODB_URL=mongodb://127.0.0.1:27017/hms

# JWT & Authentication
JWT_SECRET=your_jwt_secret_min_64_characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
PATIENT_JWT_EXPIRES_IN=8h
AUTH_OTP_ENABLED=true

# ImageKit (optional for file uploads)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINTS=

# SMS & Communication (optional)
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# AI Features (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── ABDM (Ayushman Bharat Digital Mission) Configuration ──────────────────────
ABDM_ENV=sandbox                                           # sandbox | production
ABDM_CLIENT_ID=your_abdm_client_id                         # ABDM API Client ID
ABDM_CLIENT_SECRET=your_abdm_client_secret                 # ABDM API Client Secret
ABDM_X_CM_ID=sbx                                           # sbx for sandbox, abdm for production
ABDM_GATEWAY_BASE=https://dev.abdm.gov.in/api/hiecm        # prod: https://apis.abdm.gov.in/api/hiecm
ABDM_ABHA_BASE=https://abhasbx.abdm.gov.in/abha/api        # prod: https://abha.abdm.gov.in/api/abha
ABDM_BRIDGE_URL=https://api.medical365.in                  # Public HTTPS host running Node API
ABDM_JWKS_URL=                                             # ABDM's published signing keys URL
ABDM_ALLOW_UNSIGNED_CALLBACKS=true                         # Sandbox only: allow until JWKS is confirmed
ABDM_SANDBOX_FIXED_OTP=123456                              # Sandbox only: fixed OTP if SMS provider not wired
ABDM_DATAPUSH_ENABLED=false                                # Keep false until Fidelius/FHIR data push is built
